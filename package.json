{
  "name": "screw-tool",
  "version": "1.0.0",
  "description": "打螺丝核玩工具（单文件离线版）",
  "main": "index.js",
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/run-test.mjs",
    "test:logic": "esbuild test/logic-test.mjs --bundle --platform=node --format=esm --loader:.jpg=dataurl --log-level=warning --outfile=/tmp/screw-logic.mjs && node /tmp/screw-logic.mjs",
    "test:ae": "node test/ae-export.mjs && node test/ae-mock.mjs /workspace/screw_ae_sample.zip && node test/ae-composite.mjs",
    "test:physics": "node test/physics-test.mjs",
    "test:norec": "node test/no-autorec.mjs",
    "test:holes": "node test/hole-align-test.mjs",
    "test:collision": "esbuild test/collision-test.mjs --bundle --platform=node --format=esm --log-level=warning --outfile=/tmp/screw-coll.mjs && node /tmp/screw-coll.mjs",
    "test:3d": "E3D=1 node test/ae-export.mjs && bash test/export3d-blender.sh",
    "test:collcap": "node test/collision-capture.mjs",
    "test:autoall": "node test/autosolve-all.mjs",
    "test:overlap": "node test/overlap-test.mjs",
    "test:cover": "node test/fixture-cover.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ppppan9/screw-tool.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Ppppan9/screw-tool/issues"
  },
  "homepage": "https://github.com/Ppppan9/screw-tool#readme",
  "devDependencies": {
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "planck": "^1.5.1",
    "playwright-core": "^1.64.1",
    "poly-decomp": "^0.3.0",
    "three": "^0.160.0"
  }
}
